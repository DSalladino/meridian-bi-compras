// =============================================================================
// Meridian BI · Compras & Fornecedores — medidas DAX
// Modelo: dim_calendario, dim_fornecedor, dim_categoria, dim_item, dim_unidade,
//         dim_comprador, dim_contrato, fato_pedido, fato_cotacao, fato_preco,
//         fato_orcamento
// Convenção: medidas em português, prefixos por domínio, DIVIDE sempre protegido.
// =============================================================================

// -----------------------------------------------------------------------------
// 01 · BASE
// -----------------------------------------------------------------------------
Spend :=
CALCULATE (
    SUM ( fato_pedido[valor_total] ),
    fato_pedido[status] <> "Cancelado"
)

Pedidos :=
CALCULATE (
    COUNTROWS ( fato_pedido ),
    fato_pedido[status] <> "Cancelado"
)

Ticket Médio := DIVIDE ( [Spend], [Pedidos] )

Fornecedores Ativos :=
CALCULATE (
    DISTINCTCOUNT ( fato_pedido[id_fornecedor] ),
    fato_pedido[status] <> "Cancelado"
)

Itens Comprados := DISTINCTCOUNT ( fato_pedido[id_item] )

// Quantidades seguem o mesmo universo do OTIF: entregas com data real e
// pedidos não cancelados. Assim a taxa de defeito não é diluída por cancelados.
Quantidade Recebida :=
CALCULATE (
    SUM ( fato_pedido[qtd_recebida] ),
    NOT ISBLANK ( fato_pedido[data_entrega_real] ),
    fato_pedido[status] <> "Cancelado"
)

Quantidade Defeituosa :=
CALCULATE (
    SUM ( fato_pedido[qtd_defeito] ),
    NOT ISBLANK ( fato_pedido[data_entrega_real] ),
    fato_pedido[status] <> "Cancelado"
)

// -----------------------------------------------------------------------------
// 02 · ECONOMIA (SAVINGS)
// -----------------------------------------------------------------------------
Baseline :=
CALCULATE (
    SUMX ( fato_pedido, fato_pedido[quantidade] * fato_pedido[preco_referencia] ),
    fato_pedido[status] <> "Cancelado"
)

// Mesma definição do painel/SQL: cancelados não entram em economia.
Economia :=
CALCULATE (
    SUM ( fato_pedido[saving_valor] ),
    fato_pedido[status] <> "Cancelado"
)

Taxa Economia := DIVIDE ( [Economia], [Spend] )

Economia % sobre Baseline := DIVIDE ( [Economia], [Baseline] )

Meta Economia := 0.06

Gap Meta Economia := [Economia] - [Spend] * [Meta Economia]

Economia Mês Anterior :=
CALCULATE ( [Economia], DATEADD ( dim_calendario[data], -1, MONTH ) )

Var. Economia MoM := [Economia] - [Economia Mês Anterior]

Economia Acumulada Ano :=
TOTALYTD ( [Economia], dim_calendario[data] )

Economia por Requisição := DIVIDE ( [Economia], DISTINCTCOUNT ( fato_pedido[id_requisicao] ) )

// Propostas: economia potencial do processo de cotação
Economia Cotada :=
SUMX (
    FILTER ( fato_cotacao, fato_cotacao[selecionada] = 1 ),
    fato_cotacao[quantidade] * ( fato_cotacao[preco_referencia] - fato_cotacao[preco_unitario] )
)

Spread Médio Cotação :=
AVERAGEX (
    VALUES ( fato_cotacao[id_requisicao] ),
    VAR Maior = CALCULATE ( MAX ( fato_cotacao[valor_total] ) )
    VAR Menor = CALCULATE ( MIN ( fato_cotacao[valor_total] ) )
    RETURN DIVIDE ( Maior - Menor, Maior )
)

Cotações por Requisição :=
DIVIDE (
    COUNTROWS ( fato_cotacao ),
    DISTINCTCOUNT ( fato_cotacao[id_requisicao] )
)

Requisições Competitivas % :=
VAR Reqs = VALUES ( fato_cotacao[id_requisicao] )
VAR ComTres = FILTER ( Reqs, CALCULATE ( COUNTROWS ( fato_cotacao ) ) >= 3 )
RETURN DIVIDE ( COUNTROWS ( ComTres ), COUNTROWS ( Reqs ) )

// -----------------------------------------------------------------------------
// 03 · ORÇAMENTO
// -----------------------------------------------------------------------------
Orçamento := SUM ( fato_orcamento[orcamento] )
Forecast := SUM ( fato_orcamento[forecast] )

Aderência Orçamento := DIVIDE ( [Spend], [Orçamento] )

Desvio Orçamento := [Spend] - [Orçamento]

Desvio Orçamento % := DIVIDE ( [Desvio Orçamento], [Orçamento] )

Categorias Estouradas :=
COUNTROWS (
    FILTER (
        VALUES ( dim_categoria[id_categoria] ),
        [Desvio Orçamento] > 0
    )
)

// -----------------------------------------------------------------------------
// 04 · PRAZOS E QUALIDADE
// -----------------------------------------------------------------------------
Entregas :=
CALCULATE (
    COUNTROWS ( fato_pedido ),
    NOT ISBLANK ( fato_pedido[data_entrega_real] ),
    fato_pedido[status] <> "Cancelado"
)

// Regra canônica: prazo + completude + qualidade (não depende do flag do CSV).
OTIF :=
VAR Base =
    FILTER (
        fato_pedido,
        NOT ISBLANK ( fato_pedido[data_entrega_real] )
            && fato_pedido[status] = "Entregue"
            && fato_pedido[atraso_dias] = 0
            && fato_pedido[qtd_recebida] >= fato_pedido[quantidade]
            && fato_pedido[qtd_defeito] = 0
    )
RETURN
    DIVIDE ( COUNTROWS ( Base ), [Entregas] )

// Auditoria: compara a regra canônica com o flag persistido.
OTIF por Flag :=
DIVIDE (
    CALCULATE (
        SUM ( fato_pedido[otif] ),
        NOT ISBLANK ( fato_pedido[data_entrega_real] ),
        fato_pedido[status] <> "Cancelado"
    ),
    [Entregas]
)

Divergência OTIF := [OTIF] - [OTIF por Flag]

OTIF Meta := 0.9

Gap OTIF := [OTIF] - [OTIF Meta]

Entregas Atrasadas := CALCULATE ( COUNTROWS ( fato_pedido ), fato_pedido[atraso_dias] > 0 )

% Entregas Atrasadas := DIVIDE ( [Entregas Atrasadas], [Entregas] )

Atraso Médio (dias) :=
CALCULATE (
    AVERAGE ( fato_pedido[atraso_dias] ),
    NOT ISBLANK ( fato_pedido[data_entrega_real] ),
    fato_pedido[status] <> "Cancelado"
)

Atraso P90 (dias) :=
CALCULATE (
    PERCENTILEX.INC ( fato_pedido, fato_pedido[atraso_dias], 0.9 ),
    NOT ISBLANK ( fato_pedido[data_entrega_real] ),
    fato_pedido[status] <> "Cancelado"
)

Lead Time Médio (dias) :=
CALCULATE (
    AVERAGEX (
        fato_pedido,
        DATEDIFF ( fato_pedido[data_emissao], fato_pedido[data_entrega_real], DAY )
    ),
    NOT ISBLANK ( fato_pedido[data_entrega_real] ),
    fato_pedido[status] <> "Cancelado"
)

Lead Time Planejado :=
AVERAGEX (
    fato_pedido,
    DATEDIFF ( fato_pedido[data_emissao], fato_pedido[data_entrega_prevista], DAY )
)

Aderência ao Lead Time := DIVIDE ( [Lead Time Planejado], [Lead Time Médio (dias)] )

Taxa de Defeito := DIVIDE ( [Quantidade Defeituosa], [Quantidade Recebida] )

Nota Qualidade Média := AVERAGE ( fato_pedido[nota_qualidade] )

Pedidos em Aberto :=
CALCULATE (
    COUNTROWS ( fato_pedido ),
    fato_pedido[status] IN { "Em trânsito", "Parcial", "Atrasado" }
)

Valor em Aberto :=
CALCULATE ( [Spend], fato_pedido[status] IN { "Em trânsito", "Parcial", "Atrasado" } )

Taxa de Cancelamento :=
DIVIDE (
    CALCULATE ( COUNTROWS ( fato_pedido ), fato_pedido[status] = "Cancelado" ),
    COUNTROWS ( fato_pedido )
)

// -----------------------------------------------------------------------------
// 05 · FORNECEDORES
// -----------------------------------------------------------------------------
Concentração Top 5 :=
VAR Total = [Spend]
VAR Ranking =
    ADDCOLUMNS ( VALUES ( dim_fornecedor[id_fornecedor] ), "@spend", [Spend] )
VAR Top5 =
    TOPN ( 5, Ranking, [@spend], DESC )
RETURN DIVIDE ( SUMX ( Top5, [@spend] ), Total )

HHI Fornecedores :=
VAR Total = [Spend]
VAR PorFornecedor =
    ADDCOLUMNS ( VALUES ( dim_fornecedor[id_fornecedor] ), "@spend", [Spend] )
VAR Positivos = FILTER ( PorFornecedor, [@spend] > 0 )
RETURN
    ROUND ( SUMX ( Positivos, DIVIDE ( [@spend], Total ) ^ 2 ) * 10000, 0 )

Ranking Spend Fornecedor := RANKX ( ALLSELECTED ( dim_fornecedor[razao_social] ), [Spend],, DESC )

Fornecedores Alto Risco :=
CALCULATE ( [Fornecedores Ativos], dim_fornecedor[risco] = "Alto" )

Spend Alto Risco :=
CALCULATE ( [Spend], dim_fornecedor[risco] = "Alto" )

% Spend Alto Risco := DIVIDE ( [Spend Alto Risco], [Spend] )

Cobertura Contratual :=
DIVIDE (
    CALCULATE ( [Spend], fato_pedido[tem_contrato] = TRUE() ),
    [Spend]
)

Spend Fora de Contrato :=
CALCULATE ( [Spend], fato_pedido[tem_contrato] = FALSE() )

// Mesma referência do painel/SQL: fim do mês da última emissão.
Data Referência Contratual := EOMONTH ( MAX ( fato_pedido[data_emissao] ), 0 )

Contratos Vigentes :=
VAR Ref = [Data Referência Contratual]
RETURN
    CALCULATE (
        COUNTROWS ( dim_contrato ),
        dim_contrato[status] <> "Suspenso",
        dim_contrato[data_inicio] <= Ref,
        dim_contrato[data_fim] >= Ref
    )

Contratos a Vencer 90d :=
VAR Ref = [Data Referência Contratual]
RETURN
    CALCULATE (
        COUNTROWS ( dim_contrato ),
        dim_contrato[status] <> "Suspenso",
        dim_contrato[data_inicio] <= Ref,
        dim_contrato[data_fim] >= Ref,
        dim_contrato[data_fim] <= Ref + 90
    )

Contratos Vencidos :=
VAR Ref = [Data Referência Contratual]
RETURN
    CALCULATE (
        COUNTROWS ( dim_contrato ),
        dim_contrato[status] <> "Suspenso",
        dim_contrato[data_fim] < Ref
    )

Valor Contratado :=
CALCULATE ( SUM ( dim_contrato[valor_anual] ), dim_contrato[status] = "Vigente" )

Reajustes Acima do Limite :=
CALCULATE ( COUNTROWS ( dim_contrato ), dim_contrato[reajuste_pct] > 5 )

Exposição Contratual :=
VAR Ref = [Data Referência Contratual]
VAR Fornecedor = MAX ( dim_contrato[id_fornecedor] )
VAR Categoria = MAX ( dim_contrato[id_categoria] )
VAR Fim = MAX ( dim_contrato[data_fim] )
RETURN
    CALCULATE (
        [Spend],
        REMOVEFILTERS ( dim_contrato ),
        fato_pedido[id_fornecedor] = Fornecedor,
        fato_pedido[id_categoria] = Categoria,
        fato_pedido[data_emissao] > Fim,
        fato_pedido[data_emissao] <= Ref,
        fato_pedido[status] IN { "Em trânsito", "Parcial", "Atrasado" }
    )

Competitividade :=
AVERAGEX (
    FILTER ( fato_cotacao, fato_cotacao[selecionada] = 1 ),
    1 - DIVIDE ( fato_cotacao[preco_unitario], fato_cotacao[preco_referencia] )
)

// Score composto 0–100 (prazo 35%, qualidade 25%, preço 25%, conformidade 15%)
// Regra canônica: pilar sem histórico é excluído e os pesos restantes são
// renormalizados; publica somente com >= 3 pilares. Fornecedor sem entrega ou
// sem proposta vencedora não recebe score artificial.
Score Fornecedor :=
VAR TemPrazo = NOT ISBLANK ( [OTIF] )
VAR TemQualidade = NOT ISBLANK ( [Taxa de Defeito] ) && [Quantidade Recebida] > 0
VAR TemPreco = NOT ISBLANK ( [Competitividade] )
VAR Pilares =
    IF ( TemPrazo, 1, 0 ) + IF ( TemQualidade, 1, 0 ) + IF ( TemPreco, 1, 0 ) + 1
VAR PesoDisponivel =
    IF ( TemPrazo, 0.35 ) + IF ( TemQualidade, 0.25 ) + IF ( TemPreco, 0.25 ) + 0.15
VAR Prazo = IF ( TemPrazo, [OTIF], 0 )
VAR Qualidade = IF ( TemQualidade, 1 - MIN ( 1, [Taxa de Defeito] * 25 ), 0 )
VAR Preço = IF ( TemPreco, MAX ( 0, MIN ( 1, 0.5 + [Competitividade] * 2.4 ) ), 0 )
VAR Conformidade =
    DIVIDE ( AVERAGE ( dim_fornecedor[rating_cadastral] ), 100 ) * 0.7
        + COALESCE ( [Cobertura Contratual], 0 ) * 0.3
RETURN
    IF (
        Pilares >= 3,
        ROUND (
            DIVIDE (
                Prazo * 0.35 + Qualidade * 0.25 + Preço * 0.25 + Conformidade * 0.15,
                PesoDisponivel
            ) * 100,
            1
        ),
        BLANK ()
    )

Classificação Fornecedor :=
SWITCH (
    TRUE (),
    ISBLANK ( [Score Fornecedor] ), "Sem histórico suficiente",
    [Score Fornecedor] >= 85, "Estratégico",
    [Score Fornecedor] >= 70, "Preferencial",
    [Score Fornecedor] >= 55, "Aprovado",
    "Em desenvolvimento"
)

Fornecedor Selecionado :=
IF (
    HASONEVALUE ( dim_fornecedor[razao_social] ),
    SELECTEDVALUE ( dim_fornecedor[razao_social] ),
    "Selecione um fornecedor"
)

// -----------------------------------------------------------------------------
// 06 · PREÇOS
// -----------------------------------------------------------------------------
Preço Médio Item := AVERAGE ( fato_preco[preco_medio] )

Índice de Preços :=
VAR MesAtual = MAX ( dim_calendario[ano_mes] )
VAR MesBase = CALCULATE ( MIN ( dim_calendario[ano_mes] ), ALLSELECTED ( dim_calendario ) )
VAR IndiceAtual =
    CALCULATE ( AVERAGE ( fato_preco[indice_categoria] ), fato_preco[mes_ref] = MesAtual )
VAR IndiceBase =
    CALCULATE ( AVERAGE ( fato_preco[indice_categoria] ), fato_preco[mes_ref] = MesBase )
RETURN DIVIDE ( IndiceAtual, IndiceBase ) * 100

// Variação por item comparando a competência mais recente com 12 meses antes.
Variação Preço Item 12m :=
VAR MesAtual = MAX ( fato_preco[mes_ref] )
VAR MesBase = FORMAT ( EDATE ( DATEVALUE ( MesAtual & "-01" ), -12 ), "yyyy-MM" )
VAR Atual = CALCULATE ( AVERAGE ( fato_preco[preco_medio] ), fato_preco[mes_ref] = MesAtual )
VAR Anterior = CALCULATE ( AVERAGE ( fato_preco[preco_medio] ), fato_preco[mes_ref] = MesBase )
RETURN
    IF ( ISBLANK ( MesAtual ) || ISBLANK ( Anterior ), BLANK (), DIVIDE ( Atual, Anterior ) - 1 )

// Agregado ponderado pelo spend do item (mesma regra do painel/SQL).
Variação Preços 12m :=
VAR Itens =
    ADDCOLUMNS (
        VALUES ( dim_item[id_item] ),
        "@var", [Variação Preço Item 12m],
        "@spend", [Spend]
    )
VAR Validos = FILTER ( Itens, NOT ISBLANK ( [@var] ) && [@spend] > 0 )
RETURN
    DIVIDE ( SUMX ( Validos, [@var] * [@spend] ), SUMX ( Validos, [@spend] ) )

Impacto Financeiro Reajuste := [Spend] * [Variação Preços 12m]

Itens em Alta :=
COUNTROWS ( FILTER ( VALUES ( dim_item[id_item] ), [Variação Preço Item 12m] > 0.03 ) )

// -----------------------------------------------------------------------------
// 07 · TEMPO E COMPARATIVOS
// -----------------------------------------------------------------------------
Spend Ano Anterior :=
CALCULATE ( [Spend], SAMEPERIODLASTYEAR ( dim_calendario[data] ) )

Spend YoY % := DIVIDE ( [Spend] - [Spend Ano Anterior], [Spend Ano Anterior] )

Spend MoM % :=
VAR Anterior = CALCULATE ( [Spend], DATEADD ( dim_calendario[data], -1, MONTH ) )
RETURN DIVIDE ( [Spend] - Anterior, Anterior )

Spend Acumulado Ano := TOTALYTD ( [Spend], dim_calendario[data] )

Spend Média Móvel 3M :=
AVERAGEX (
    DATESINPERIOD ( dim_calendario[data], MAX ( dim_calendario[data] ), -3, MONTH ),
    [Spend]
)

// Previsão simples de tendência; o painel usa regressão linear em /app/js/kpi.js.
Previsão Spend Próximo Mês :=
[Spend Média Móvel 3M] * ( 1 + COALESCE ( [Spend MoM %], 0 ) )

Previsão Spend 3M := [Spend Média Móvel 3M] * 3

// Simulação de renegociação (tabela 'Parâmetros Simulação' com colunas
// Desconto e Cobertura, ambas em fração 0–1).
Desconto Simulado := COALESCE ( SELECTEDVALUE ( 'Parâmetros Simulação'[Desconto] ), 0.03 )
Cobertura Simulada := COALESCE ( SELECTEDVALUE ( 'Parâmetros Simulação'[Cobertura] ), 0.6 )
Economia Incremental Simulada := [Spend] * [Cobertura Simulada] * [Desconto Simulado]
Nova Taxa Economia Simulada := DIVIDE ( [Economia] + [Economia Incremental Simulada], [Spend] - [Economia Incremental Simulada] )

Pedidos por Comprador := DIVIDE ( [Pedidos], DISTINCTCOUNT ( fato_pedido[id_comprador] ) )

// -----------------------------------------------------------------------------
// 08 · TÍTULOS DINÂMICOS E UX
// -----------------------------------------------------------------------------
Título Período :=
VAR MinData = MIN ( dim_calendario[data] )
VAR MaxData = MAX ( dim_calendario[data] )
RETURN FORMAT ( MinData, "dd/mm/yyyy" ) & " a " & FORMAT ( MaxData, "dd/mm/yyyy" )

Título Filtros :=
CONCATENATEX (
    FILTER (
        VALUES ( dim_categoria[categoria] ),
        NOT ISBLANK ( [Spend] )
    ),
    dim_categoria[categoria],
    " · "
)

KPI Dinâmico :=
SWITCH (
    SELECTEDVALUE ( 'Parâmetros'[Indicador], "Spend" ),
    "Spend", FORMAT ( [Spend], "R$ #.0,, mi" ),
    "Economia", FORMAT ( [Economia], "R$ #.0,, mi" ),
    "OTIF", FORMAT ( [OTIF], "0.0%" ),
    "Aderência", FORMAT ( [Aderência Orçamento], "0%"),
    FORMAT ( [Spend], "R$ #.0,, mi" )
)

Cor Semáforo OTIF :=
SWITCH ( TRUE (), [OTIF] >= 0.9, "#7fc8a9", [OTIF] >= 0.8, "#e9c46a", "#e89b93" )

Cor Semáforo Aderência :=
SWITCH ( TRUE (), [Aderência Orçamento] <= 1, "#7fc8a9", [Aderência Orçamento] <= 1.05, "#e9c46a", "#e89b93" )
