# ---------------------------------------------------------------------------
# PostgreSQL local (docker compose) — camada analítica do ETL/Power BI
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meridian

# Power BI Service / gateway (use um usuário somente leitura em produção)
PGHOST=localhost
PGPORT=5432
PGDATABASE=meridian
PGUSER=leitor_bi
PGPASSWORD=troque-esta-senha

# ---------------------------------------------------------------------------
# Servidor de produção (npm run start:prod)
# ---------------------------------------------------------------------------
PORT=4173
HOST=0.0.0.0

# Obrigatório em produção: openssl rand -base64 48
MERIDIAN_SESSION_SECRET=

# Apenas no primeiro boot do container; remova depois de criar o admin.
MERIDIAN_BOOTSTRAP_ADMIN=

# 1 quando o painel estiver atrás de HTTPS (recomendado em produção)
MERIDIAN_SECURE_COOKIE=0

# 1 quando houver proxy reverso confiável (Nginx/Caddy/Traefik)
MERIDIAN_TRUST_PROXY=0

# Duração da sessão em horas
MERIDIAN_SESSION_HOURS=8

# Caminhos opcionais
# MERIDIAN_USERS=config/usuarios.json
# MERIDIAN_AUDIT_DIR=logs
# MERIDIAN_MAX_IMPORT_ROWS=200000
# MERIDIAN_MAX_UPLOAD_ROWS=5000
# MERIDIAN_LOGIN_LIMIT=8
